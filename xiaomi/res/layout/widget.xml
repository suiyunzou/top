<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/widget_background">
    <ImageView android:id="@+id/card" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="ftop 设备状态。点击查看详情。" />
    <TextView android:id="@+id/placeholder" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:text="ftop\n设备状态" android:textColor="#f4f6fa" android:textSize="24sp" />
    <TextView android:id="@+id/refresh" android:layout_width="84dp" android:layout_height="48dp"
        android:layout_gravity="bottom|end" android:gravity="center" android:text="↻ 刷新"
        android:textSize="12sp" android:textColor="#a7c8ff" android:contentDescription="刷新设备状态" />
    <TextView android:id="@+id/network_download" android:layout_width="48dp" android:layout_height="48dp"
        android:focusable="true" android:contentDescription="下载，查看各应用下载流量" />
    <TextView android:id="@+id/network_upload" android:layout_width="48dp" android:layout_height="48dp"
        android:focusable="true" android:contentDescription="上传，查看各应用上传流量" />
</FrameLayout>
